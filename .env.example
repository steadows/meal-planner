# Telegram — meal bot (separate token from the agentic-OS bot; see PLAN.md "Reuse the existing bot")
TELEGRAM_BOT_TOKEN=
TELEGRAM_ALLOWED_CHAT_ID=

# Mealie — long-lived token from /user/profile/api-tokens
MEALIE_URL=http://localhost:9925
MEALIE_TOKEN=

# Local state
PANTRY_DB=./data/pantry.sqlite
PREFS_FILE=./meals/prefs.yaml

# Claude Code — must be signed in with /login (API keys cannot drive Chrome)
CLAUDE_BIN=claude
CLAUDE_MAX_CONCURRENT=2

# Cart fill — host that runs Chrome + the Claude extension + the Meijer session
# (blank = this machine; otherwise a Tailscale SSH target like steve@macbook)
CHROME_HOST=

# Optional: voice notes
WHISPER_MODEL=base

# Optional: Instacart backup cart path
INSTACART_API_KEY=
